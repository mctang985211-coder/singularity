{
  "name": "singularity-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The one protocol stack: one envelope, one append path, one fold engine, one version gate, one refusal contract.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node assembly/build.mjs",
    "test": "vitest run",
    "gates": "node scripts/gates.mjs",
    "verify": "node -e \"console.log('verify: offline only; no product evidence')\" && pnpm build && pnpm test && pnpm gates",
    "setup:host": "node scripts/setup-host.mjs",
    "doctor": "node scripts/singularity.mjs doctor",
    "build-private-dsh": "node scripts/build-private-dsh.mjs",
    "verify:domain": "node scripts/verify-domain.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "12.10.0",
    "playwright": "^1.64.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.9.3",
    "vite": "8.3.3",
    "vitest": "^4.1.8",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence-jsonl": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.18.0",
  "license": "UNLICENSED",
  "bin": {
    "singularity": "scripts/singularity.mjs"
  }
