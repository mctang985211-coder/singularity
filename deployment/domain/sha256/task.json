{
  "rootTemplate": "sha256-schedule",
  "inputs": [
    {
      "ref": "testbench",
      "from": "tb/tb_sha256_w_mem_selfcheck.v"
    }
  ],
  "templates": [
    {
      "id": "sha256-schedule",
      "goal": "implement the SHA256 message schedule under the protected NIST selfcheck",
      "input": {
        "name": "tb/tb_sha256_w_mem_selfcheck.v",
        "source": {
          "kind": "protected",
          "ref": "testbench"
        }
      },
      "workspace": {
        "submission": "source",
        "file": "rtl/sha256_w_mem.v",
        "artifact": "rtl/sha256_w_mem.v",
        "initial": "seed/sha256_w_mem.v"
      },
      "criterion": {
        "criterionId": "w-schedule",
        "statement": "the edited module produces the message schedule every published NIST vector requires, as the protected self-checking testbench compares it round by round",
        "verifier": "functional"
      }
    }
  ],
  "verifiers": [
    {
      "ref": "functional",
      "version": "1",
      "program": "functional.mjs",
      "args": [
        "{artifact}",
        "{input}"
      ],
      "selftest": [
        {
          "name": "accepts the unmodified upstream module",
          "expected": "pass",
          "artifact": "seed/sha256_w_mem.v",
          "argv": [
            "seed/sha256_w_mem.v",
            "tb/tb_sha256_w_mem_selfcheck.v"
          ]
        },
        {
          "name": "rejects a module whose schedule is wrong in one round",
          "expected": "fail",
          "artifact": "samples/fail-w_mem.v",
          "argv": [
            "samples/fail-w_mem.v",
            "tb/tb_sha256_w_mem_selfcheck.v"
          ]
        },
        {
          "name": "rejects a wrong module that also prints the pass line itself",
          "expected": "fail",
          "artifact": "samples/fail-printing-cheat.v",
          "argv": [
            "samples/fail-printing-cheat.v",
            "tb/tb_sha256_w_mem_selfcheck.v"
          ]
        },
        {
          "name": "rejects a module that ends the simulation early, which exits zero and never compares a word",
          "expected": "fail",
          "artifact": "samples/fail-early-finish.v",
          "argv": [
            "samples/fail-early-finish.v",
            "tb/tb_sha256_w_mem_selfcheck.v"
          ]
        },
        {
          "name": "rejects a module that prints the pass line and ends the simulation in the same block, which exits zero with the line on stdout and nothing compared",
          "expected": "fail",
          "artifact": "samples/fail-print-and-finish.v",
          "argv": [
            "samples/fail-print-and-finish.v",
            "tb/tb_sha256_w_mem_selfcheck.v"
          ]
        }
      ]
    }
  ]
}
