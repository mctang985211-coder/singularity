diff --git a/packages/core/session/tests/ignorable-append.spec.ts b/packages/core/session/tests/ignorable-append.spec.ts
new file mode 100644
index 0000000000..3faa1eb377
--- /dev/null
+++ b/packages/core/session/tests/ignorable-append.spec.ts
@@ -0,0 +1,38 @@
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore, { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { validateStoredEvents } from '@deepseek-ai/dsh-session-persistence'
+import { expect, it, vi } from 'vitest'
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    'external/metering-test': { tokens: number }
+  }
+}
+
+it('appends an explicitly ignorable plugin record that persists and restores without changing messages', async () => {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  try {
+    const session = ctx.sessions.create(SessionId('external-metering'))
+    const observed = vi.fn()
+    ctx.on('session/event', observed)
+    const event = session.append('external/metering-test', { tokens: 13 }, { ignorable: true })
+    expect(event.ignorable).toBe(true)
+    expect(observed).toHaveBeenCalledWith(session, event)
+    const events = session.snapshotEvents()
+    expect(() => validateStoredEvents(session.header, [...events])).not.toThrow()
+    const restored = Session.create(session.id, events)
+    expect(restored.eventAt(event.seq)).toEqual(event)
+    expect(restored.deriveMessages()).toEqual([])
+    expect(restored.surface.nodes).toEqual([])
+    const required = { ...event, ignorable: undefined }
+    expect(() => validateStoredEvents(session.header, [required])).toThrow('not marked ignorable')
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('rejects a malformed omission marker before publishing the log-only record', () => {
+  const session = Session.create(SessionId('invalid-marker'))
+  expect(() => session.append('external/metering-test', { tokens: 1 }, { ignorable: false } as never))
+    .toThrow('ignorable marker must be true')
+  expect(session.seq).toBe(0)
+})
