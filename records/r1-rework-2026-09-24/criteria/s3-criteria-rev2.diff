+/**
+ * The criterion ids an active contract requires (revision 2, §4.1 M3): a
+ * criterion without a `mandatory` field counts as required; only an explicit
+ * `mandatory: false` releases it.
+ */
+function requiredContractCriteria(contract: S3Contract | undefined): string[] {
+  const ids: string[] = []
+  for (const criterion of contract?.acceptanceCriteria ?? []) {
+    if (criterion.mandatory === false) continue
+    const id = text(criterion.criterionId)
+    if (id !== undefined && id.length > 0 && !ids.includes(id)) ids.push(id)
+  }
+  return ids
+}
