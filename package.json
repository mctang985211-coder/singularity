{
  "name": "singularity-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The one protocol stack: one envelope, one append path, one fold engine, one version gate, one refusal contract.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node assembly/build.mjs",
    "test": "vitest run",
    "gates": "node scripts/gates.mjs",
    "verify": "node -e \"console.log('verify: offline only; no product evidence')\" && pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm gates && pnpm audit:context && pnpm audit:distribution --pack && pnpm audit:docs",
    "setup:host": "node scripts/setup-host.mjs",
    "doctor": "node scripts/singularity.mjs doctor",
    "build-private-dsh": "node scripts/build-private-dsh.mjs",
    "verify:domain": "node scripts/verify-domain.mjs",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:native": "vitest run --config vitest.native.config.ts",
    "verify:core": "pnpm lint && pnpm format:check && pnpm test:core && pnpm gates --core && pnpm audit:context && pnpm audit:distribution && pnpm audit:docs",
    "verify:native": "pnpm lint && pnpm format:check && pnpm build && pnpm test:native && pnpm gates && pnpm audit:distribution --pack && pnpm audit:docs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage:core": "vitest run --config vitest.coverage.config.ts --coverage",
    "audit:context": "node scripts/context-audit.mjs",
    "audit:distribution": "node scripts/distribution.mjs",
    "experiment:prepare": "node scripts/experiment.mjs prepare",
    "experiment:seal": "node scripts/experiment.mjs seal",
    "experiment:replay": "node scripts/experiment.mjs replay",
    "experiment:export": "node scripts/evidence-export.mjs",
    "audit:docs": "node scripts/docs-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "@xyflow/react": "12.10.0",
    "eslint": "^10.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.3",
    "vitest": "^4.1.8",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence-jsonl": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.18.0",
  "license": "UNLICENSED",
  "bin": {
    "singularity": "scripts/singularity.mjs"
  }
}
