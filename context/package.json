{
  "name": "@dangosys/dsh-singularity-context",
  "description": "Singularity agent context: trusted session-to-graph bindings, same-domain reads, and context projections",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-query": "*",
    "@deepseek-ai/dsh-system-prompt": "*"
  },
  "dependencies": {
    "@dangosys/dsh-singularity-graphs": "workspace:*",
    "@dangosys/dsh-singularity-task": "workspace:*",
    "@dangosys/dsh-singularity-task-runtime": "workspace:*"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "link:../../../thirdparty/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../thirdparty/deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-session": "link:../../../thirdparty/deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-session-query": "link:../../../thirdparty/deepseek-harness/packages/session-query/session-query",
    "@deepseek-ai/dsh-system-prompt": "link:../../../thirdparty/deepseek-harness/packages/core/system-prompt"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DangoSys/singularity.git",
    "directory": "context"
  },
  "homepage": "https://github.com/DangoSys/singularity",
  "bugs": {
    "url": "https://github.com/DangoSys/singularity/issues"
  }
}
