{
  "name": "@dangosys/dsh-singularity-verifier",
  "description": "Singularity verifier registry, built-in command/composite/review verifiers, and evidence bundle construction",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@dangosys/dsh-singularity-task": "workspace:*"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "link:../../../thirdparty/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-sandbox": "link:../../../thirdparty/deepseek-harness/packages/sandbox/sandbox",
    "@deepseek-ai/dsh-sandbox-policy": "link:../../../thirdparty/deepseek-harness/packages/sandbox/sandbox-policy",
    "@deepseek-ai/dsh-subprocess": "link:../../../thirdparty/deepseek-harness/packages/subprocess/subprocess",
    "@deepseek-ai/dsh-subprocess-local": "link:../../../thirdparty/deepseek-harness/packages/subprocess/subprocess-local",
    "@deepseek-ai/schemastery": "link:../../../thirdparty/deepseek-harness/vendor/schemastery",
    "@dangosys/dsh-singularity-task": "link:../task"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DangoSys/singularity.git",
    "directory": "verifier"
  },
  "homepage": "https://github.com/DangoSys/singularity",
  "bugs": {
    "url": "https://github.com/DangoSys/singularity/issues"
  }
}
