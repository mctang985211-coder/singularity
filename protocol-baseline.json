      "readBy": "src/measure/view.ts projectEvaluation (the aggregate, the missing denominator and the admissibility of one candidate) and caliberDigestOf (the comparability a round pools on)"
    },
    {
      "protocol": "release",
      "version": 3,
      "subject": "the environment whose head is moving",
      "kinds": [
        {
          "name": "release/approved",
          "members": [
            "revisionId",
            "draftDigest",
            "approvedBy",
            "approvalId",
            "review"
          ]
