{
  "name": "@dangosys/dsh-singularity-agent",
  "description": "Singularity root agent tools",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-user-approval": "*",
    "@deepseek-ai/dsh-user-questions": "*"
  },
  "dependencies": {
    "@dangosys/dsh-singularity-agent-runtime": "workspace:*",
    "@dangosys/dsh-singularity-context": "workspace:*",
    "@dangosys/dsh-singularity-evolution": "workspace:*",
    "@dangosys/dsh-singularity-graphs": "workspace:*",
    "@dangosys/dsh-singularity-task": "workspace:*",
    "@dangosys/dsh-singularity-task-runtime": "workspace:*"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "link:../../../thirdparty/deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../../thirdparty/deepseek-harness/vendor/schemastery",
    "@deepseek-ai/dsh-tools": "link:../../../thirdparty/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-session": "link:../../../thirdparty/deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-llm": "link:../../../thirdparty/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-user-approval": "link:../../../thirdparty/deepseek-harness/packages/interaction/user-approval",
    "@deepseek-ai/dsh-user-questions": "link:../../../thirdparty/deepseek-harness/packages/interaction/user-questions"
  },
  "publishConfig": {
    "access": "public"
  }
}
