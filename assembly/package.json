{
  "name": "@dangosys/dsh-singularity-next",
  "version": "0.0.0",
  "private": true,
  "description": "The assembly layer: a DSH agent drives the singularity-core task pipeline through tools, and every fact lands in the one control store",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./web": "./lib/web.js",
