        {
          "name": "release/drafted",
          "members": [
            "revisionId",
            "contentDigest",
            "draftDigest",
            "basis"
          ]
        }
      ],
      "producedBy": "src/release/commands.ts createReleaseCommands (bootstrap draft or committed-winner draftFromDecision, and approveReview with exact independent review evidence)",
      "readBy": "src/release/commands.ts publish (rechecks the complete approved draft, committed decision/report, content and expected head before the one pointer switch)"
    },
    {
      "protocol": "review",
      "version": 5,
      "subject": "the independent review id",
      "kinds": [
        {
          "name": "review/completed",
          "members": [
