{
  "name": "@dangosys/dsh-singularity",
  "description": "Singularity meta-bundle for DeepSeek Harness",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "presets/*.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "pack:check": "pnpm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/bb-verify.patch.yml",
        "./presets/singularity-reviewer.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent-preset": "*",
    "@deepseek-ai/dsh-agent-preset-registry": "*"
  },
  "dependencies": {
    "@dangosys/dsh-singularity-graph": "workspace:*",
    "@dangosys/dsh-singularity-graphs": "workspace:*",
    "@dangosys/dsh-singularity-task": "workspace:*",
    "@dangosys/dsh-singularity-verifier": "workspace:*",
    "@dangosys/dsh-singularity-task-runtime": "workspace:*",
    "@dangosys/dsh-singularity-context": "workspace:*",
    "@dangosys/dsh-singularity-agent-runtime": "workspace:*",
    "@dangosys/dsh-singularity-agent": "workspace:*",
    "@dangosys/dsh-singularity-graph-web": "workspace:*",
    "@dangosys/dsh-singularity-map": "workspace:*",
    "@dangosys/dsh-singularity-canvas-view": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../thirdparty/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent-preset": "link:../../../thirdparty/deepseek-harness/packages/preset/agent-preset",
    "@deepseek-ai/dsh-agent-preset-registry": "link:../../../thirdparty/deepseek-harness/packages/preset/agent-preset-registry",
    "@types/node": "^22.20.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DangoSys/singularity.git",
    "directory": "bundle"
  },
  "homepage": "https://github.com/DangoSys/singularity",
  "bugs": {
    "url": "https://github.com/DangoSys/singularity/issues"
  }
}
